# 极义托管代理本地服务环境变量示例。
# 安装脚本会把本文件复制到 ~/.codex-session-delete/jiyi-managed-proxy.env。
# 真实 Key 只应写入本机私有 env 文件或服务端环境变量，不要提交到 Git。

# 本地验收默认只监听回环地址，避免局域网机器直接访问。
JIYI_MANAGED_PROXY_LISTEN="127.0.0.1:57421"

# 当前默认上游是阿里百炼千问兼容接口；APIMart 可作为备选或替换为自建中转站。
JIYI_MANAGED_PROXY_UPSTREAM_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"

# 服务端上游 API Key。公开分发时不要把该 Key 写入客户端或文档。
JIYI_MANAGED_PROXY_UPSTREAM_API_KEY=""

# 极义账号同步 API Key。管理工具向 /jiyi/v1/identity/sync 同步账号时使用。
JIYI_MANAGED_PROXY_SYNC_API_KEY=""

# 极义全量管理 API Key。可调用所有 /jiyi/v1/admin/* 管理接口。
JIYI_MANAGED_PROXY_ADMIN_API_KEY=""

# 极义用户只读 API Key。只允许读取 /jiyi/v1/admin/users。
JIYI_MANAGED_PROXY_USER_READ_API_KEY=""

# 极义计费 API Key。只允许调整用户/团队额度、记录续费和触发对账。
JIYI_MANAGED_PROXY_BILLING_API_KEY=""

# 极义支付回调 API Key。支付网关调用 /jiyi/v1/billing/payment-webhook 时使用。
JIYI_MANAGED_PROXY_PAYMENT_WEBHOOK_API_KEY=""

# 极义支付回调 HMAC-SHA256 验签密钥。配置后回调必须携带
# X-Jiyi-Payment-Timestamp 和 X-Jiyi-Payment-Signature。
JIYI_MANAGED_PROXY_PAYMENT_WEBHOOK_SIGNATURE_SECRET=""

# 支付宝开放平台 RSA2 公钥。生产建议使用 *_PATH 指向私有 PEM 文件。
JIYI_MANAGED_PROXY_ALIPAY_PUBLIC_KEY=""
JIYI_MANAGED_PROXY_ALIPAY_PUBLIC_KEY_PATH=""

# 微信支付 v3 平台公钥 / 微信支付公钥。生产建议使用 *_PATH 指向私有 PEM 文件。
JIYI_MANAGED_PROXY_WECHATPAY_PUBLIC_KEY=""
JIYI_MANAGED_PROXY_WECHATPAY_PUBLIC_KEY_PATH=""

# 极义风控 API Key。只允许调用 /jiyi/v1/admin/users/block 和 /unblock。
JIYI_MANAGED_PROXY_ACCESS_API_KEY=""

# 极义审计只读 API Key。只允许读取 /jiyi/v1/admin/audit/events，不允许改用户状态或套餐。
JIYI_MANAGED_PROXY_AUDIT_API_KEY=""

# 本地后端 SQLite。部署到服务端时可改成服务端持久化路径。
JIYI_MANAGED_PROXY_DB_PATH="$HOME/.codex-session-delete/jiyi-codex-local-backend.sqlite"
